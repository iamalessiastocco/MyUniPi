# Configurazione dell'API
API_BASE_URL=http://localhost:8000/api

# Configurazione del Database (se applicabile)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=myuni_pi_db
DB_USERNAME=root
DB_PASSWORD=tua_password

# Configurazione dell'Autenticazione
JWT_SECRET=la_tua_chiave_segreta_per_jwt
JWT_EXPIRES_IN=3600

# Configurazione dell'Ambiente
NODE_ENV=development
APP_URL=http://localhost:3000

# Configurazione di Firebase (se usi Firebase per il badge digitale)
FIREBASE_API_KEY=tua_chiave_api
FIREBASE_AUTH_DOMAIN=tua_app.firebaseapp.com
FIREBASE_PROJECT_ID=tua_app
FIREBASE_STORAGE_BUCKET=tua_app.appspot.com
FIREBASE_MESSAGING_SENDER_ID=1234567890
FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890

# Configurazione per il Calendario Accademico
CALENDAR_API_URL=https://api.unipi.it/calendar
CALENDAR_API_KEY=tua_chiave_api_calendario

# Configurazione per il Social e le Risorse
TELEGRAM_CHAT_LINK=https://t.me/joinchat/
OFFICIAL_UNIVERSITY_LINK=https://www.unipi.it
